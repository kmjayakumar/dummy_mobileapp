{
  "expo": {
    "name": "FullStack App",
    "slug": "fullstack-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f0f0f"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yourcompany.fullstackapp"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f0f0f"
      },
      "package": "com.yourcompany.fullstackapp",
      "minSdkVersion": 24
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "@config-plugins/ffmpeg-kit-react-native",
        {
          "package": "audio",
          "android": {
            "package": "audio"
          },
          "ios": {
            "package": "audio"
          }
        }
      ]
    ],
    "scheme": "fullstackapp",
    "experiments": {
      "typedRoutes": false
    }
  }
}
